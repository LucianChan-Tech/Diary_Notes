@Entry
@Component
struct LoginPage {
  @State private account: string = '';
  @State private password: string = '';
  @State private isLoading: boolean = false;
  @State private showPassword: boolean = false;

  aboutToAppear(): void {
    UserSessionRepository.initialize();
  }

  private navigateReplace(url: string): void {
    void this.getUIContext().getRouter().replaceUrl({ url }).catch((): void => {});
  }

  private showToast(message: string, duration: number = 2000): void {
    try {
      this.getUIContext().getPromptAction().showToast({ message, duration });
    } catch (error) {
    }
  }

  private doLogin(accountName: string): void {
    UserSessionRepository.setCurrentUser(accountName);
    this.navigateReplace('pages/MainPage');
  }

  private handleLogin(): void {
    if (this.account.trim().length === 0) {
      this.showToast('è¯·è¾“å…¥è´¦å·ã€‚', 2000);
      return;
    }

    if (this.password.length === 0) {
      this.showToast('è¯·è¾“å…¥å¯†ç ã€‚', 2000);
      return;
    }

    this.isLoading = true;
    setTimeout((): void => {
      this.isLoading = false;
      this.doLogin(this.account.trim());
    }, 800);
  }

  build() {
    Column() {
      Column() {
        Stack() {
          Circle()
            .width(80)
            .height(80)
            .fill('#CF0A2C')

          Text('H')
            .fontSize(44)
            .fontWeight(FontWeight.Bold)
            .fontColor(Color.White)
        }

        Text('åŽä¸ºè´¦å·')
          .fontSize(22)
          .fontWeight(FontWeight.Bold)
          .fontColor('#1A1A1A')
          .margin({ top: 14 })

        Text('ä½¿ç”¨åŽä¸ºè´¦å·ç™»å½•æ—¥è®°å¤‡å¿˜å½•')
          .fontSize(13)
          .fontColor('#757575')
          .margin({ top: 6 })
      }
      .margin({ top: 60, bottom: 40 })

      Column() {
        Row() {
          Text('è´¦å·')
            .fontSize(14)
            .fontColor('#555555')
            .width(72)

          TextInput({ placeholder: 'è¯·è¾“å…¥è´¦å·æˆ–æ‰‹æœºå·', text: this.account })
            .layoutWeight(1)
            .fontSize(15)
            .backgroundColor(Color.Transparent)
            .border({ width: 0 })
            .onChange((value: string) => {
              this.account = value;
